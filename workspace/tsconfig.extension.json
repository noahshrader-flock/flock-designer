{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vscode"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": [
		"extension/src/**/*",
		"extension/webview/**/*",
		"src/shared/**/*",
		"src/host/**/*",
		"src/main/**/*",
		"src/site/**/*",
		"src/page/**/*",
		"src/renderer/useWorkspace.ts",
		"src/renderer/runPrototypeBuild.ts",
		"src/renderer/localBuild.ts",
		"src/renderer/address.ts",
		"src/renderer/useCover.ts",
		"src/renderer/useComponentPictures.ts",
		"src/renderer/tokenChanges.ts",
		"src/renderer/useTokenBranch.ts",
		"src/renderer/useChangeBranch.ts",
		"src/renderer/useValueBranch.ts",
		"src/renderer/useFrameHeight.ts",
		"src/renderer/useStoryPreview.ts",
		"src/renderer/useChangeReach.ts",
		"src/renderer/useTriedAnswer.ts",
		"src/renderer/useValueSources.ts",
		"src/renderer/useComponentVariants.ts",
		"src/renderer/askWhile.ts",
		"src/renderer/useComponentTokens.ts",
		"src/renderer/useCatalogRead.ts",
		"src/renderer/useColorField.ts",
		"src/renderer/useSpecimenPreview.ts",
		"src/renderer/workspace.d.ts"
	]
}
