{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vscode"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": [
		"extension/src/**/*",
		"extension/webview/**/*",
		"src/shared/**/*",
		"src/host/**/*",
		"src/main/**/*",
		"src/site/**/*",
		"src/page/**/*",
		"src/renderer/useWorkspace.ts",
		"src/renderer/workspace.d.ts"
	]
}
