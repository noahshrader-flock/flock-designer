{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"composite": false,
		"noImplicitAny": false
	},
	"include": ["**/*.mjs", "**/*.cjs"],
	"exclude": ["node_modules", "extension/dist", "out"]
}
