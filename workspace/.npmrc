# This project resolves public packages from npmjs.org directly.
#
# The machine-level ~/.npmrc points `registry` at Flock's CodeArtifact mirror,
# whose token expires and needs an `aws login` in a browser to refresh. Coke
# needs that mirror. This app does not: its only Flock dependency is FUI, which
# comes from GitHub Packages. Declaring both here means a fresh clone installs
# without an AWS session.
registry=https://registry.npmjs.org/
@flocksafety:registry=https://npm.pkg.github.com/
