{
	"name": "dsnr",
	"settingsFolder": "flock-designer",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.13"
	},
	"description": "Local coordination layer over real Flock product repositories.",
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.viewer.json && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.test.json",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "vitest run --project unit --project dom",
		"test:integration": "vitest run --project integration",
		"test:libraries": "vitest run --project library --reporter=verbose",
		"format": "prettier --write .",
		"lint": "eslint .",
		"check:static": "prettier --check . && npm run lint && npm run typecheck",
		"check": "npm run check:static && npm test",
		"check:full": "npm run check && npm run test:libraries",
		"extension:build": "node extension/build.mjs",
		"extension:dev": "node extension/dev.mjs",
		"extension:test": "node extension/build.mjs && node extension/test/run.mjs",
		"extension:test:packaged": "node extension/test/run.mjs --packaged",
		"extension:package": "node extension/package.mjs",
		"extension:install": "node extension/package.mjs --install"
	},
	"dependencies": {
		"axe-core": "^4.14.0",
		"esbuild": "^0.25.12",
		"postcss": "^8.5.28",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sass": "^1.105.1"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/vscode": "~1.100.0",
		"@vitejs/plugin-react": "^4.3.4",
		"@vscode/codicons": "^0.0.46-24",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.10",
		"puppeteer-core": "^25.13.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.71.2",
		"vite": "^7.3.7",
		"vitest": "^5.0.2"
	}
}
