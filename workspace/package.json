{
	"name": "dsnr",
	"productName": "DSNR",
	"settingsFolder": "flock-designer",
	"version": "0.1.0",
	"private": true,
	"description": "Local coordination layer over real Flock product repositories.",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.viewer.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"check": "prettier --check . && npm run typecheck && vitest run",
		"smoke": "npm run build && node scripts/smoke-boot.mjs",
		"smoke:page": "npm run build && node scripts/smoke-page.mjs",
		"smoke:local": "npm run build && node scripts/smoke-local.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"axe-core": "^4.14.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"esbuild": "^0.25.12",
		"lucide-react": "^1.52.0",
		"luxon": "^3.4.4",
		"markdown-to-jsx": "^9.10.3",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sass": "^1.105.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@types/luxon": "^3.4.2",
		"@types/node": "^22.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "^44.5.0",
		"electron-vite": "^5.0.0",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.10",
		"shadcn": "^4.21.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.2"
	}
}
