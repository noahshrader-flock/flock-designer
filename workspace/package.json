{
	"name": "flock-designer",
	"version": "0.1.0",
	"private": true,
	"description": "Local coordination layer over real Flock product repositories.",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"smoke": "npm run build && node scripts/smoke-boot.mjs"
	},
	"dependencies": {
		"@flocksafety/flock-react-component-lib": "5.6.5",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/icons-material": "^5.15.1",
		"@mui/material": "^5.14.20",
		"luxon": "^3.4.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/luxon": "^3.4.2",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "^44.5.0",
		"electron-vite": "^5.0.0",
		"typescript": "^5.7.2",
		"vitest": "^5.0.2"
	}
}
