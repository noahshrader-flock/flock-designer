{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": [
		"package.json",
		"src/main/**/*",
		"src/cli/**/*",
		"src/site/**/*",
		"src/preload/**/*",
		"src/shared/**/*",
		"electron.vite.config.ts",
		"viewer.vite.config.ts",
		"vitest.config.ts",
		"scripts/**/*"
	]
}
