{
	"name": "dsnr",
	"displayName": "DSNR",
	"description": "Prototype from the real design system, beside the code.",
	"version": "0.0.1",
	"publisher": "flocksafety",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onFileSystem:dsnr-voice"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "DSNR runs the commands a repository declares, builds its code and hands it to Claude Code, so it runs only in a workspace you trust."
		},
		"virtualWorkspaces": {
			"supported": false,
			"description": "DSNR works on a checkout on this machine, with git and the repository's own tools."
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dsnr",
					"title": "DSNR",
					"icon": "$(code-oss)"
				}
			]
		},
		"views": {
			"dsnr": [
				{
					"type": "webview",
					"id": "dsnr.panel",
					"name": "DSNR"
				}
			]
		},
		"commands": [
			{
				"command": "dsnr.open",
				"category": "DSNR",
				"title": "Open"
			},
			{
				"command": "dsnr.getStarted",
				"category": "DSNR",
				"title": "Get started"
			},
			{
				"command": "dsnr.newPrototype",
				"category": "DSNR",
				"title": "New prototype",
				"icon": "$(add)"
			},
			{
				"command": "dsnr.openReview",
				"category": "DSNR",
				"title": "Open a prototype for review"
			},
			{
				"command": "dsnr.openPublishedPage",
				"category": "DSNR",
				"title": "Open the published page",
				"icon": "$(link-external)"
			},
			{
				"command": "dsnr.copyPublishedLink",
				"category": "DSNR",
				"title": "Copy the published page’s link",
				"icon": "$(link)"
			},
			{
				"command": "dsnr.assignFolder",
				"category": "DSNR",
				"title": "Assign folder…"
			},
			{
				"command": "dsnr.buildInCodebase",
				"category": "DSNR",
				"title": "Build in the codebase…"
			},
			{
				"command": "dsnr.openComponent",
				"title": "Open a component…",
				"category": "DSNR"
			},
			{
				"command": "dsnr.openPrimitives",
				"title": "Open Primitives",
				"category": "DSNR"
			},
			{
				"command": "dsnr.openVoiceAndTone",
				"title": "Open Voice and Tone",
				"category": "DSNR"
			},
			{
				"command": "dsnr.proposeVoiceAndTone",
				"title": "Propose the voice and tone",
				"category": "DSNR",
				"icon": "$(git-pull-request)"
			},
			{
				"command": "dsnr.startOverVoiceAndTone",
				"title": "Start over on the voice and tone",
				"category": "DSNR",
				"icon": "$(discard)"
			},
			{
				"command": "dsnr.sync",
				"category": "DSNR",
				"title": "Sync your work"
			},
			{
				"command": "dsnr.signIn",
				"category": "DSNR",
				"title": "Sign in to GitHub",
				"icon": "$(sign-in)"
			},
			{
				"command": "dsnr.account",
				"category": "DSNR",
				"title": "Your GitHub account",
				"icon": "$(account)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "dsnr.newPrototype",
					"when": "view == dsnr.panel",
					"group": "navigation@1"
				},
				{
					"command": "dsnr.signIn",
					"when": "view == dsnr.panel && !dsnr.signedIn",
					"group": "navigation@9"
				},
				{
					"command": "dsnr.account",
					"when": "view == dsnr.panel && dsnr.signedIn",
					"group": "navigation@9"
				}
			],
			"commandPalette": [
				{
					"command": "dsnr.signIn",
					"when": "!dsnr.signedIn"
				},
				{
					"command": "dsnr.account",
					"when": "dsnr.signedIn"
				},
				{
					"command": "dsnr.openPublishedPage",
					"when": "activeWebviewPanelId == 'dsnr.review'"
				},
				{
					"command": "dsnr.copyPublishedLink",
					"when": "activeWebviewPanelId == 'dsnr.review'"
				},
				{
					"command": "dsnr.assignFolder",
					"when": "activeWebviewPanelId == 'dsnr.review'"
				},
				{
					"command": "dsnr.buildInCodebase",
					"when": "activeWebviewPanelId == 'dsnr.review'"
				},
				{
					"command": "dsnr.proposeVoiceAndTone",
					"when": "resourceScheme == dsnr-voice && !activeEditorIsReadonly"
				},
				{
					"command": "dsnr.startOverVoiceAndTone",
					"when": "resourceScheme == dsnr-voice && !activeEditorIsReadonly"
				}
			],
			"editor/title": [
				{
					"command": "dsnr.openPublishedPage",
					"when": "activeWebviewPanelId == 'dsnr.review'",
					"group": "navigation@1"
				},
				{
					"command": "dsnr.copyPublishedLink",
					"when": "activeWebviewPanelId == 'dsnr.review'",
					"group": "navigation@2"
				},
				{
					"command": "dsnr.assignFolder",
					"when": "activeWebviewPanelId == 'dsnr.review'",
					"group": "1_project"
				},
				{
					"command": "dsnr.buildInCodebase",
					"when": "activeWebviewPanelId == 'dsnr.review'",
					"group": "1_project"
				},
				{
					"command": "dsnr.proposeVoiceAndTone",
					"when": "resourceScheme == dsnr-voice && !activeEditorIsReadonly",
					"group": "navigation@1"
				},
				{
					"command": "dsnr.startOverVoiceAndTone",
					"when": "resourceScheme == dsnr-voice && !activeEditorIsReadonly",
					"group": "navigation@2"
				}
			],
			"webview/context": [
				{
					"command": "dsnr.assignFolder",
					"when": "webviewId == 'dsnr.panel' && webviewSection == 'project'"
				}
			]
		},
		"configuration": {
			"title": "DSNR",
			"properties": {
				"dsnr.agent.location": {
					"type": "string",
					"enum": [
						"sidebar",
						"editor"
					],
					"default": "sidebar",
					"enumDescriptions": [
						"The agent's side panel.",
						"An editor tab."
					],
					"description": "Where an agent that has a panel in VS Code (Claude Code) opens what DSNR hands it: its side panel, or an editor tab."
				},
				"dsnr.claudeCode.location": {
					"type": "string",
					"enum": [
						"sidebar",
						"editor"
					],
					"deprecationMessage": "Now dsnr.agent.location: DSNR moves a value set here to it when it starts."
				}
			}
		}
	}
}
