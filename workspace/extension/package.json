{
	"name": "dsnr",
	"displayName": "DSNR",
	"description": "Prototype from the real design system, beside the code.",
	"version": "0.0.1",
	"publisher": "flocksafety",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dsnr",
					"title": "DSNR",
					"icon": "media/dsnr.svg"
				}
			]
		},
		"views": {
			"dsnr": [
				{
					"type": "webview",
					"id": "dsnr.panel",
					"name": "DSNR"
				}
			]
		},
		"commands": [
			{
				"command": "dsnr.open",
				"category": "DSNR",
				"title": "Open"
			},
			{
				"command": "dsnr.newPrototype",
				"category": "DSNR",
				"title": "New prototype",
				"icon": "$(add)"
			},
			{
				"command": "dsnr.openReview",
				"category": "DSNR",
				"title": "Open a prototype for review"
			},
			{
				"command": "dsnr.signIn",
				"category": "DSNR",
				"title": "Sign in to GitHub",
				"icon": "$(sign-in)"
			},
			{
				"command": "dsnr.account",
				"category": "DSNR",
				"title": "Your GitHub account",
				"icon": "$(account)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "dsnr.newPrototype",
					"when": "view == dsnr.panel",
					"group": "navigation@1"
				},
				{
					"command": "dsnr.signIn",
					"when": "view == dsnr.panel && !dsnr.signedIn",
					"group": "navigation@9"
				},
				{
					"command": "dsnr.account",
					"when": "view == dsnr.panel && dsnr.signedIn",
					"group": "navigation@9"
				}
			],
			"commandPalette": [
				{
					"command": "dsnr.signIn",
					"when": "!dsnr.signedIn"
				},
				{
					"command": "dsnr.account",
					"when": "dsnr.signedIn"
				}
			]
		}
	}
}
