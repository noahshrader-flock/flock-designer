{
	"name": "dsnr",
	"displayName": "DSNR",
	"description": "Prototype from the real design system, beside the code.",
	"version": "0.0.1",
	"publisher": "flocksafety",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dsnr",
					"title": "DSNR",
					"icon": "media/dsnr.svg"
				}
			]
		},
		"views": {
			"dsnr": [
				{
					"type": "webview",
					"id": "dsnr.panel",
					"name": "DSNR"
				}
			]
		},
		"commands": [
			{
				"command": "dsnr.open",
				"title": "DSNR: Open"
			},
			{
				"command": "dsnr.openReview",
				"title": "DSNR: Open a prototype for review"
			}
		]
	}
}
